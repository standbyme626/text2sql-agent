# ============================================================
# Text-to-SQL Agent 配置模板（v3.1：多账号 / 模型主备 / 文件知识库）
# 复制为项目根 .env 后填写。⚠️ .env 含密钥，已加入 .gitignore，勿外传。
# ============================================================

# ---------- 服务 ----------
# 本项目经 SSH 反向隧道 + nginx 对公网可达；无论 HOST 写什么，
# 未配置 AUTH_PASSWORD 时服务都会拒绝启动（公网可达性与 HOST 无关）。
HOST=127.0.0.1
PORT=3388
PUBLIC_BASE_PATH=
# 生产显式写站点域名；留空 = 仅同源，不再默认允许任意来源
CORS_ORIGINS=https://sql.example.com

# ---------- 鉴权（公网暴露必填，见 README 安全章节）----------
# 多账号：用户名:密码:角色，逗号分隔。角色 admin 可进管理后台，user 只能问答。
# 密码里不要出现逗号；生产请用强密码。
AUTH_USERS=sqladmin:change-me-admin:admin,guest:change-me-guest:user
# 旧单账号配置仅在 AUTH_USERS 为空时生效（角色固定 admin）
AUTH_USER=admin
AUTH_PASSWORD=
TOKEN_TTL_HOURS=24
# 可选，不填则自动生成并保存在 backend/data/.secret_key（600）
SECRET_KEY=

# ---------- 文本大模型：主模型 + 兜底 ----------
# 默认 opencode-go DeepSeek V4.1 Flash（OpenAI 兼容）
LLM_PROVIDER=opencode-go
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
# 兜底：OpenRouter 免费模型（主模型 429/超时/空返回时自动切换）
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=baidu/ernie-5.5-flash-preview:free
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1

# ---------- 向量模型：硅基流动 SiliconFlow ----------
EMB_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMB_MODEL=Qwen/Qwen3-Embedding-8B
EMB_DIM=1024
EMB_TIMEOUT=60

# ---------- 2026 Agent ----------
# toolloop = 工具调用循环（默认）；workflow = 旧固定流水线（不支持 tools 的模型）
AGENT_MODE=toolloop
MAX_AGENT_STEPS=6
MAX_TOOL_SQL=4
TOOL_ROW_PREVIEW=20
COLUMN_LINK_TOPK=8
# 受治理指标层（YAML）。留空用 backend/semantic/metrics.yaml
SEMANTIC_FILE=
# 文件知识库（Wren AI 风格）：knowledge/sql/*.md + knowledge/rules/*.md
KNOWLEDGE_DIR=

# ---------- 数据源 ----------
# 默认 SQLite；填 postgresql://... 切 Postgres（先用 build_meta_pg.py 生成 meta）
DATABASE_URL=

# ---------- Agent 参数（次数/上限类配置均自动钳制，误配不会失控）----------
TOP_K_TABLES=6
FEWSHOT_K=2
MAX_SQL_RETRY=2
MAX_LLM_CALLS=6
FK_EXPAND_MAX=3
MAX_RESULT_ROWS=500
SQL_TIMEOUT_MS=5000
HISTORY_TURNS=6
# 自动生成中文结论 + 可点击追问（默认开；每次提问多 1 次轻量 LLM 调用）
AUTO_INSIGHT=true
FOLLOWUP_COUNT=3
INSIGHT_MAX_TOKENS=1200
# 洞察提示词里最多喂多少行结果（默认 20；太少会让模型误判趋势范围）
INSIGHT_PREVIEW_ROWS=50
# 返回 0 行时把「空结果」回灌模型放宽条件重试一次（ReAct Observation）
EMPTY_RESULT_RETRY=true
# 异常问题护栏：无关 / 越权 / 模糊时拒答，并给出可点击的正确问法
GUARD_ENABLED=true
GUARD_SUGGESTIONS=3

# ---------- 观测 / 记忆 ----------
TRACE_ENABLED=true
TRACE_RECENT=200
MEMORY_ENABLED=true

# ---------- 限流与资源保护 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=40
REBUILD_COOLDOWN=300
MAX_QA_HISTORY=400
MAX_BODY_BYTES=1000000
SSE_HEARTBEAT_SEC=15

# ---------- 开关 ----------
# MOCK_MODE=true：不调用任何外部 API，用本地伪向量 + 规则 SQL，用于零额度自测
MOCK_MODE=false
# 索引缺失/损坏时自动重建一次（正常启动不触发，不额外消耗额度）
AUTO_BUILD_INDEX=true
# 仅本地容器调试时置 1，跳过「必须鉴权」检查；生产勿用
ALLOW_INSECURE=0

# ---------- 自测专用（一般不设）----------
# TEXT2SQL_DATA_DIR：覆盖数据目录，selftest.py 用它完全隔离，不碰线上数据
